+
+  case GWEN_DialogProperty_Width: {
+    int width, height;
+
+    gtk_window_get_default_size(g, &width, &height);
+    return width;
+  }
+
+  case GWEN_DialogProperty_Height: {
+    int width, height;
+
+    gtk_window_get_default_size(g, &width, &height);
+    return height;
+  }
+
+  default:
+    break;
+  }
+
+  DBG_WARN(GWEN_LOGDOMAIN,
+           "Function is not appropriate for this type of widget (%s)",
