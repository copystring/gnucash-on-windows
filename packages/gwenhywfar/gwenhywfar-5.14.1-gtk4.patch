+  Gtk4Gui_ApplyFlags(GTK_WIDGET(gContent), GWEN_WIDGET_FLAGS_FILLX|GWEN_WIDGET_FLAGS_FILLY);
+  gtk_scrolled_window_set_child(GTK_SCROLLED_WINDOW(g), gContent);
