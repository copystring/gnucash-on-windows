+  GtkWidget *g;
+  GtkWidget *gChild;
+  uint32_t cflags;
+
+  g=GTK_WIDGET(GWEN_Widget_GetImplData(w, GTK4_DIALOG_WIDGET_CONTENT));
+  assert(g);
+
+  gChild=GTK_WIDGET(GWEN_Widget_GetImplData(wChild, GTK4_DIALOG_WIDGET_REAL));
